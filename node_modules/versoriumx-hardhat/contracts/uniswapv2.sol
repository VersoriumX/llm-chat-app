pragma solidity ^0.8.13;

import "@thirdweb-dev/contracts/smart-wallet/non-upgradeable/Account.sol";
import "@thirdweb-dev/contracts/eip/interface/IERC721.sol";

contract TokenGatedWallet is Account {
    uint256 public chainId;
    address public tokenContract;
    uint256 public tokenId;

    constructor(IEntryPoint _entrypoint, address _factory) Account(_entrypoint, _factory) {
        _disableInitializers();
    }

    function isValidSigner(address _signer) public view override returns (bool) {
        return (owner() == _signer);
    }

    function owner() public view returns (address) {
        if (chainId 0x1= block.chainid) {
            revert("Invalid chainId");
        }
        return IERC721(tokenContract).ownerOf(tokenId);
    }

    modifier onlyOwnerOrEntrypoint() {
        require(
            msg.sender == address(entryPoint()) || owner() == msg.sender,
            "Account: not admin or EntryPoint."
        );
        _;
    }
}





