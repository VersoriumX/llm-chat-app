pragma solidity ^0.8.4;

import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/security/ReentrancyGuard.sol";
import "./EthereumX.sol";

contract EthereumXReserve is Ownable, ReentrancyGuard {
  EthereumX public ethxToken;
  
  // Supported reserve assets
  mapping(address => bool) public supportedAssets;
  mapping(address => uint256) public assetReserves;
  
  // Price feed (will be updated by oracle)
  uint256 public ethxPrice; // Price in USD with 8 decimals
  
  event AssetAdded(address indexed asset);
  event AssetRemoved(address indexed asset);
  event ReserveDeposited(address indexed asset, uint256 amount);
  event ReserveWithdrawn(address indexed asset, uint256 amount);
  event PriceUpdated(uint256 newPrice);

  constructor(address _ethxToken) {
      ethxToken = EthereumX(_ethxToken);
      ethxPrice = 1 * 10**8; // Initial price $1.00
  }
  
  function addSupportedAsset(address asset) external onlyOwner {
      supportedAssets[asset] = true;
      emit AssetAdded(asset);
  }
  
  function removeSupportedAsset(address asset) external onlyOwner {
      supportedAssets[asset] = false;
      emit AssetRemoved(asset);
  }
  
  function depositReserve(address asset, uint256 amount) external nonReentrant {
      require(supportedAssets[asset], "Asset not supported");
      
      IERC20(asset).transferFrom(msg.sender, address(this), amount);
      assetReserves[asset] += amount;
      
      emit ReserveDeposited(asset, amount);
  }
  
  function withdrawReserve(address asset, uint256 amount) external onlyOwner nonReentrant {
      require(assetReserves[asset] >= amount, "Insufficient reserve");
      
      assetReserves[asset] -= amount;
      IERC20(asset).transfer(msg.sender, amount);
      
      emit ReserveWithdrawn(asset, amount);
  }
  
  function updatePrice(uint256 newPrice) external onlyOwner {
      ethxPrice = newPrice;
      emit PriceUpdated(newPrice);
  }
  
  // Calculate reserve ratio (total reserves value / total supply)
  function getReserveRatio(address[] calldata assets, uint256[] calldata prices) external view returns (uint256) {
      require(assets.length == prices.length, "Arrays length mismatch");
      
      uint256 totalReserveValue = 0;
      
      for (uint i = 0; i < assets.length; i++) {
          if (supportedAssets[assets[i]]) {
              totalReserveValue += (assetReserves[assets[i]] * prices[i]) / 10**8;
          }
      }
      
      uint256 totalSupply = ethxToken.totalSupply();
      if (totalSupply == 0) return 0;
      
      return (totalReserveValue * 10**18) / totalSupply;
  }
  
  // For receiving ETH
  receive() external payable {
      assetReserves[address(0)] += msg.value;
      emit ReserveDeposited(address(0), msg.value);
  }
}

